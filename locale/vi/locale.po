msgid "plugins.generic.reviewerCertificate.myCertificates.viewAll"
msgstr "Xem tất cả giấy chứng nhận của tôi"

msgid "plugins.generic.reviewerCertificate.myCertificates.emailAction"
msgstr "Gửi giấy chứng nhận qua email cho tôi"

msgid "plugins.generic.reviewerCertificate.myCertificates.emailSent"
msgstr "Giấy chứng nhận đã được gửi đến địa chỉ email của bạn."

msgid "plugins.generic.reviewerCertificate.myCertificates.emailError"
msgstr "Không thể gửi email. Vui lòng thử lại sau hoặc liên hệ với tạp chí."

msgid "plugins.generic.reviewerCertificate.settings.ackEmailSubject"
msgstr "Tiêu đề email cảm ơn"

msgid "plugins.generic.reviewerCertificate.settings.ackEmailBody"
msgstr "Nội dung email cảm ơn"

msgid "plugins.generic.reviewerCertificate.settings.ackEmailDescription"
msgstr "Thư gửi cho người phản biện từ trang Giấy chứng nhận của tôi, kèm theo tệp PDF giấy chứng nhận. Hỗ trợ các biến mẫu giống như nội dung giấy chứng nhận, cùng với {{$editorName}}."

msgid "plugins.generic.reviewerCertificate.emailCertificate.attachmentFallback"
msgstr "Không thể đính kèm tệp PDF giấy chứng nhận vào email này (có thể tệp vượt quá giới hạn dung lượng của máy chủ thư). Bạn có thể tải xuống giấy chứng nhận tại đây:"

msgid "plugins.generic.reviewerCertificate.emailCertificate.defaultSubject"
msgstr "Thư cảm ơn về việc phản biện cho {{$journalName}}"

msgid "plugins.generic.reviewerCertificate.emailCertificate.defaultBody"
msgstr "Kính gửi {{$reviewerName}},\n\nChúng tôi xin chân thành cảm ơn Quý vị đã dành thời gian và công sức phản biện bản thảo \"{{$submissionTitle}}\" gửi đến {{$journalName}}. Những nhận xét kỹ lưỡng và sâu sắc của Quý vị đã mang lại những góp ý quý báu, giúp các tác giả hoàn thiện công trình và phát triển hơn nữa hướng nghiên cứu của mình.\n\nChúng tôi đánh giá rất cao đóng góp của Quý vị trong việc duy trì chất lượng các bài báo đăng trên tạp chí. Chúng tôi hiểu rằng phản biện bản thảo là một công việc đòi hỏi nhiều công sức, và chúng tôi ghi nhận sự tận tâm của Quý vị trong việc phân tích kỹ lưỡng bản thảo và đưa ra những góp ý mang tính xây dựng cho các tác giả.\n\nĐể ghi nhận đóng góp của Quý vị, chúng tôi trân trọng đề nghị Quý vị chuyển tiếp thư này đến reviews@webofscience.com. Xin lưu ý rằng, theo chính sách biên tập của chúng tôi, nội dung phản biện sẽ được giữ bảo mật và không được hiển thị trên Web of Science.\n\nGiấy chứng nhận phản biện của Quý vị được đính kèm theo thư này.\n\nMột lần nữa, chúng tôi xin cảm ơn sự đóng góp của Quý vị cho sự phát triển nghiên cứu trong lĩnh vực của mình. Chúng tôi rất mong tiếp tục được hợp tác cùng Quý vị trong thời gian tới.\n\nTrân trọng,\n\n{{$editorName}}\n{{$journalName}}"

msgid "plugins.generic.reviewerCertificate.notifications.title"
msgstr "Thông báo giấy chứng nhận đã cấp trước đây"

msgid "plugins.generic.reviewerCertificate.notifications.description"
msgstr "Gửi chủ động một email thông báo cho mỗi giấy chứng nhận đến những người phản biện được chọn. Các giấy chứng nhận đủ điều kiện nhưng chưa được tạo sẽ được tạo mới. Các giấy chứng nhận được cấp trước khi có tính năng theo dõi thông báo không có lịch sử gửi và có thể đã được thông báo trước đó. Việc tạo giấy chứng nhận hàng loạt thông thường không gửi email."

msgid "plugins.generic.reviewerCertificate.notifications.retry"
msgstr "Gửi lại các thông báo thất bại hoặc chưa xác định"

msgid "plugins.generic.reviewerCertificate.notifications.retryWarning"
msgstr "Một lần gửi bị gián đoạn quá mười phút được coi là chưa xác định: người nhận có thể đã nhận được email. Chỉ gửi lại các thông báo chưa xác định sau khi đã kiểm tra nhật ký máy chủ thư."

msgid "plugins.generic.reviewerCertificate.notifications.send"
msgstr "Gửi thông báo giấy chứng nhận"

msgid "plugins.generic.reviewerCertificate.notifications.sent"
msgstr "Đã gửi"

msgid "plugins.generic.reviewerCertificate.settings.saveFailed"
msgstr "Không thể lưu cài đặt giấy chứng nhận. Vui lòng kiểm tra các trường và ảnh (JPEG hoặc PNG, tối đa 5 MB), sau đó thử lại."

