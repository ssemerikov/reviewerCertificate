msgstr "Tạo giấy chứng nhận cho nhiều người phản biện cùng lúc. Chọn từ danh sách dưới đây những người phản biện đã hoàn thành phản biện nhưng chưa có giấy chứng nhận."

msgid "plugins.generic.reviewerCertificate.batch.selectReviewers"
msgstr "Chọn người phản biện"

msgid "plugins.generic.reviewerCertificate.batch.completedReviews"
msgstr "phản biện đã hoàn thành"

msgid "plugins.generic.reviewerCertificate.batch.noEligibleReviewers"
msgstr "Không có người phản biện nào đủ điều kiện. Tất cả người phản biện đều đã có giấy chứng nhận cho các phản biện đã hoàn thành."

msgid "plugins.generic.reviewerCertificate.batch.selectMultipleHint"
msgstr "Giữ Ctrl (Windows/Linux) hoặc Cmd (Mac) để chọn nhiều người phản biện"

msgid "plugins.generic.reviewerCertificate.batch.generate"
msgstr "Tạo giấy chứng nhận"

