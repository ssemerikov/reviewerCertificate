msgid "plugins.generic.reviewerCertificate.settings.uploadFailed"
msgstr "Tải tệp lên thất bại. Vui lòng thử lại."

msgid "plugins.generic.reviewerCertificate.settings.fontUnicodeWarning"
msgstr "Lưu ý: Helvetica, Times New Roman và Courier chỉ hỗ trợ ký tự Latin cơ bản, không hiển thị được dấu tiếng Việt (ă, â, đ, ê, ô, ơ, ư và các dấu thanh). Nếu văn bản có chứa tiếng Việt có dấu hoặc các ký tự ngoài bảng chữ cái Latin cơ bản, plugin sẽ tự động dùng phông DejaVu Sans cho các phần văn bản đó."

msgid "plugins.generic.reviewerCertificate.settings.invalidValue"
msgstr "Vui lòng nhập giá trị hợp lệ."

# Error messages
msgid "plugins.generic.reviewerCertificate.error.reviewNotCompleted"
msgstr "Phản biện này chưa hoàn thành. Giấy chứng nhận chỉ được cấp cho các phản biện đã hoàn thành."

msgid "plugins.generic.reviewerCertificate.error.noCertificateCode"
msgstr "Chưa cung cấp mã giấy chứng nhận"

msgid "plugins.generic.reviewerCertificate.error.invalidCertificate"
msgstr "Mã giấy chứng nhận không hợp lệ. Không thể xác minh giấy chứng nhận này."

msgid "plugins.generic.reviewerCertificate.error.noReviewersSelected"
msgstr "Chưa chọn người phản biện nào để tạo giấy chứng nhận hàng loạt"

msgid "plugins.generic.reviewerCertificate.error.accessDenied"
msgstr "Truy cập bị từ chối. Bạn không có quyền tải xuống giấy chứng nhận này."

msgid "plugins.generic.reviewerCertificate.error.noContext"
msgstr "Không xác định được tạp chí. Vui lòng đảm bảo bạn truy cập từ một tạp chí hợp lệ."

msgid "plugins.generic.reviewerCertificate.error.daoNotAvailable"
msgstr "Hiện không thể truy cập cơ sở dữ liệu. Vui lòng liên hệ quản trị viên hệ thống."

# Email templates
msgid "plugins.generic.reviewerCertificate.email.subject"
msgstr "Giấy chứng nhận của bạn đã sẵn sàng!"

msgid "plugins.generic.reviewerCertificate.email.body"
msgstr "{{$reviewerName}},\n\nCảm ơn bạn đã hoàn thành phản biện này. Bạn có thể tải xuống giấy chứng nhận ghi nhận đóng góp của mình.\n\nTải xuống giấy chứng nhận: {{$certificateUrl}}\n\n{{$journalName}}\n{{$journalUrl}}"

